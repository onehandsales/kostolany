{
  "expo": {
    "name": "Kostolany",
    "slug": "kostolany-mobile",
    "version": "0.1.0",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": [["expo-image-picker", {
      "cameraPermission": "프로필 사진을 촬영할 때 카메라를 사용합니다.",
      "photosPermission": "선택한 사진을 프로필에 표시합니다.",
      "microphonePermission": false
    }], ["expo-media-library", {
      "savePhotosPermission": "공유 카드를 사진 보관함에 저장합니다.",
      "granularPermissions": [],
      "preventAutomaticLimitedAccessAlert": true
    }]],
    "android": {
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_MEDIA_AUDIO", "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"]
    },
    "ios": {
      "supportsTablet": false
    }
  }
}
