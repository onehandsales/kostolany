{
  "expo": {
    "name": "Kostolany",
    "slug": "kostolany-mobile",
    "scheme": "kostolany",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "프로필 사진이나 작성 중인 글의 사진을 촬영할 때 카메라를 사용합니다.",
          "photosPermission": "선택한 사진을 프로필이나 작성 중인 글에 표시합니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "공유 카드를 사진 보관함에 저장합니다.",
          "granularPermissions": [],
          "preventAutomaticLimitedAccessAlert": true
        }
      ],
      "./plugins/withAppIcons",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/start-wordmark.png",
          "imageWidth": 308,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 200
          }
        }
      ]
    ],
    "android": {
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "ios": {
      "supportsTablet": false
    },
    "icon": "./assets/app-icons/wordmark-black.png"
  }
}
