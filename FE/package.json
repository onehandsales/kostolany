    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "expo": "57.0.33",
    "expo-clipboard": "~57.0.2",
    "expo-file-system": "57.0.7",
    "expo-image-manipulator": "57.0.22",
    "expo-image-picker": "57.0.21",
    "expo-media-library": "~57.0.6",
    "expo-notifications": "~57.0.25",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.17",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --localhost --port 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@10.9.0"
